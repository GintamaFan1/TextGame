; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false

[application]

config/name="Tester2"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"
Inventory="*res://classes/inventory.gd"
SaveManager="*res://auto_load/save_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/GameGUI/plugin.cfg", "res://addons/area_of_sight_2d/plugin.cfg", "res://addons/better-terrain/plugin.cfg", "res://addons/complex_shape_creation/plugin.cfg", "res://addons/goutte.animated_shape_2d/plugin.cfg", "res://addons/multi_touchscreenbutton/plugin.cfg", "res://addons/net.yarvis.pixel_pen/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/softbody2d/plugin.cfg")

