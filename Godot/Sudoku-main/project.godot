[layer_names]

2d_render/layer_1="player"
2d_render/layer_2="enemy"
2d_render/layer_3="stage_object"
2d_render/layer_4="item_object"
2d_render/layer_5="character_ability"
2d_render/layer_6="train"
2d_render/layer_7="worm"
2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="stage_object"
2d_physics/layer_4="item_object"
2d_physics/layer_5="character_ability"
2d_physics/layer_6="train"
2d_physics/layer_7="worm"

[physics]

2d/default_gravity=150.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
