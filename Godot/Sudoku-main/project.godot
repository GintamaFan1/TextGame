; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sudoku"
run/main_scene="res://Scenes/main_ui.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://addons/awesome_scene_manager/autoloads/SceneManager.tscn"
DisplayMessage="*res://auto_load2/error_message.gd"
UpdateResources="*res://auto_load2/update_resources.gd"
AudioManager="*res://auto_load2/AudioManager.gd"
Sucker="*res://auto_load2/Sucker.gd"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GameGUI/plugin.cfg", "res://addons/awesome_scene_manager/plugin.cfg", "res://addons/better-terrain/plugin.cfg", "res://addons/complex_shape_creation/plugin.cfg")

[gui]

theme/custom="res://Themes/Universal_label_theme/new_theme.tres"

